{
  email off
}

{$PAYFLOW_API_DOMAIN} {
  encode zstd gzip

  @health path /actuator/health*
  @api path /api/*

  reverse_proxy api-gateway:8080

  header {
    -Server
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  log {
    output stdout
    format console
  }
}
