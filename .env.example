# Local Docker / development environment.
# Never commit a real .env file.

POSTGRES_USER=payflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# HS512: must be at least 64 bytes. Example: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_openssl_rand_base64_64

API_KEY_PEPPER=CHANGE_ME_openssl_rand_base64_32
PAYFLOW_INTERNAL_TOKEN=CHANGE_ME_openssl_rand_base64_32

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password

PAYFLOW_ADMIN_EMAIL=admin@payflow.local
PAYFLOW_ADMIN_PASSWORD=CHANGE_ME_min_12_chars
PAYFLOW_AUTO_VERIFY_EMAIL=true

PAYFLOW_CORS_ORIGINS=http://localhost:5173

# Default/test provider. No external credentials are needed for sandbox mode.
PAYFLOW_PROVIDER_DEFAULT=sandbox
SANDBOX_WEBHOOK_SECRET=CHANGE_ME_sandbox_webhook_secret
# Leave false for local/manual webhook tests. Render blueprint enables it for demo UX.
SANDBOX_AUTO_CAPTURE=false
SANDBOX_AUTO_CAPTURE_DELAY_MS=5000

# Optional: set these only when switching PAYFLOW_PROVIDER_DEFAULT=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reserved configuration only. A Stripe PaymentGateway implementation is not
# present in the current core build, so Stripe should not be selected yet.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
