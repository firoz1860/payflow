# Copy to .env.oracle on the Oracle VM.
# deploy-oracle.sh generates strong random defaults when this file is absent.

POSTGRES_USER=payflow
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_MIN_64_BYTES
API_KEY_PEPPER=CHANGE_ME
PAYFLOW_INTERNAL_TOKEN=CHANGE_ME

PAYFLOW_ADMIN_EMAIL=admin@payflow.local
PAYFLOW_ADMIN_PASSWORD=CHANGE_ME
PAYFLOW_AUTO_VERIFY_EMAIL=true

PAYFLOW_PROVIDER_DEFAULT=sandbox
SANDBOX_WEBHOOK_SECRET=CHANGE_ME
SANDBOX_AUTO_CAPTURE=true
SANDBOX_AUTO_CAPTURE_DELAY_MS=5000

# Your Vercel production origin, no trailing slash.
PAYFLOW_CORS_ORIGINS=https://payflow-firozs-projects-70dbf044.vercel.app

# A custom domain is ideal. For a zero-cost temporary domain use:
# <YOUR_PUBLIC_IP>.sslip.io
PAYFLOW_API_DOMAIN=YOUR_PUBLIC_IP.sslip.io

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
