# PayFlow dashboard (frontend) — build-time environment variables.
# Copy to `.env` for local overrides. All Vite vars MUST be prefixed with VITE_.

# Absolute base URL of the deployed PayFlow API gateway, INCLUDING the /api/v1 suffix.
#
#   Local dev  : leave EMPTY. Requests fall back to '/api/v1' and the Vite dev
#                server proxies them to http://localhost:8080 (see vite.config.ts).
#   Production : set to your gateway origin, e.g.
#                VITE_API_URL=https://payflow-gateway.onrender.com/api/v1
#
# NOTE: this is baked into the static bundle at build time, so it is PUBLIC.
#       Never put secrets in VITE_* variables.
VITE_API_URL=
