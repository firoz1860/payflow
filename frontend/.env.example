# Production (Vercel)
# Set this in Vercel Project Settings -> Environment Variables.
# Example:
# VITE_API_URL=https://payflow-api-gateway.onrender.com/api/v1
VITE_API_URL=

# Local development only.
# When the backend is started with the repository docker-compose.yml,
# API Gateway is published on host port 8000.
VITE_DEV_API_PROXY=http://localhost:8000

# PayFlow Copilot (AI):
# There is intentionally NO AI/LLM key here. Provider API keys (Anthropic,
# OpenAI, Gemini, xAI, custom) are NEVER exposed as a VITE_ variable, because
# any VITE_ value is bundled into the public frontend build. Keys are entered
# in the in-app "Connect provider" modal and sent only to the PayFlow backend,
# which stores and uses them server-side. Do not add an AI key as a VITE_ var.

# Landing / auth hero — optional live Spline 3D scene.
# The hero ships with a built-in animated fallback and needs NOTHING set here.
# To show the interactive Spline scene instead, publish it from the Spline
# editor (Export -> Code / Public URL) and paste the resulting *.splinecode
# URL below. This is a public asset URL, not a secret; it is safe as a VITE_
# var. When unset, the premium CSS/framer-motion fallback is used.
# Example:
# VITE_SPLINE_SCENE_URL=https://prod.spline.design/XXXXXXXXXXXX/scene.splinecode
VITE_SPLINE_SCENE_URL=
